# Секреты и локальная конфигурация
.env

# БД, загрузки, бэкапы, логи — не должны попадать в репозиторий
instance/
*.db

# Python
__pycache__/
*.pyc
.pytest_cache/

# Виртуальное окружение
venv/
.venv/

# IDE
.vscode/
.idea/

# Личные настройки Claude Code (не для команды)
.claude/settings.local.json


# Сертификаты КЭП для агента ЭЗП — в git только README (в клиентском — СНИЛС/ИНН председателя)
ezp_agent/certs/*
!ezp_agent/certs/README.md

# Флаг заглушки «Технические работы» (deployment/deploy-from-git/deploy.sh)
deployment/maintenance.on

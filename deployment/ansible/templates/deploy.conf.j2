# Создан плейбуком deployment/ansible для deployment/deploy.sh
# (образец со всеми пояснениями — deploy.conf.example рядом с ним). Плейбук
# этот файл больше не трогает — правьте сами.
DEPLOY_BRANCH={{ app_branch }}
DEPLOY_HOST={{ ansible_host | default(inventory_hostname) }}
DEPLOY_PORT={{ ssh_port }}
DEPLOY_USER={{ app_user }}
# Вход — по ключу из deploy_ssh_pubkeys, перезапуск сервиса — sudo без пароля.
DEPLOY_PASSWORD=
APP_DIR={{ app_dir }}
APP_USER={{ app_user }}
{% set extra = extra_instances | default([]) %}
SERVICES="{{ ([service_name] + extra | map(attribute='service') | list) | join(' ') }}"
HEALTH_URLS="{% for port in [app_port] + extra | map(attribute='port') | list %}{{ ' ' if not loop.first }}http://127.0.0.1:{{ port }}/{% endfor %}"
HEALTH_TIMEOUT=90
BACKUP_BEFORE=1
{% if extra %}
# Бэкап БД перед обновлением — каждого кооператива; ПОЛЬЗОВАТЕЛЬ:ФАЙЛ —
# под этим пользователем через sudo (правило ставит плейбук).
BACKUP_ENV_FILES="{{ app_dir }}/.env{% for i in extra %} {{ i.user }}:{{ i.env_file }}{% endfor %}"
{% else %}
BACKUP_ENV_FILES=""
{% endif %}

# {{ ansible_managed }} — правится в ~/.config/garage-coop/vars.yml, не здесь:
# следующий прогон плейбука перезапишет файл. Описание переменных — .env.example.
SECRET_KEY={{ app_secret_key }}
BANK_API_ENCRYPTION_KEY={{ app_bank_api_encryption_key }}
{% if app_env_file is defined %}
# Дополнительный кооператив (coop_extra_instances): код общий, данные свои.
INSTANCE_DIR={{ app_instance_dir }}
{% endif %}
FORCE_HTTPS={{ 1 if env_https | bool else 0 }}
BEHIND_PROXY=1
FLASK_DEBUG=0
{% if recaptcha_site_key %}
RECAPTCHA_SITE_KEY={{ recaptcha_site_key }}
RECAPTCHA_SECRET_KEY={{ recaptcha_secret_key }}
{% endif %}
{% set lan_subnets = lan_vpn | default([]) | selectattr('coop', 'equalto', lan_vpn_coop) | map(attribute='subnets') | flatten %}
{% if lan_subnets and 'GARAGE_MAP_LAN_SUBNETS' not in app_env_extra %}
# Локальная сеть гаражей через VPN (lan_vpn_peers)
GARAGE_MAP_LAN_SUBNETS={{ lan_subnets | join(',') }}
{% endif %}
{% if max_route_secret | default('') and extra_instances | default([]) %}
# Один бот MAX на все кооперативы сервера (app/max_router.py, max_route_secret)
MAX_ROUTE_SECRET={{ max_route_secret }}
{% if app_env_file is defined %}
MAX_COOP_CODE={{ inst.name }}
MAX_RECEIVE=forwarded
{% else %}
MAX_ROUTE_PEERS={% for i in extra_instances %}{{ i.name }}=http://127.0.0.1:{{ i.port }}{{ ',' if not loop.last }}{% endfor %}

{% endif %}
{% endif %}
{% for name, value in app_env_extra.items() %}
{{ name }}={{ value }}
{% endfor %}

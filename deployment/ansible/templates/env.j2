# {{ ansible_managed }} — правится в ~/.config/garage-coop/vars.yml, не здесь:
# следующий прогон плейбука перезапишет файл. Описание переменных — .env.example.
SECRET_KEY={{ app_secret_key }}
BANK_API_ENCRYPTION_KEY={{ app_bank_api_encryption_key }}
FORCE_HTTPS={{ 1 if https_enabled | bool else 0 }}
BEHIND_PROXY=1
FLASK_DEBUG=0
{% if recaptcha_site_key %}
RECAPTCHA_SITE_KEY={{ recaptcha_site_key }}
RECAPTCHA_SECRET_KEY={{ recaptcha_secret_key }}
{% endif %}
{% for name, value in app_env_extra.items() %}
{{ name }}={{ value }}
{% endfor %}

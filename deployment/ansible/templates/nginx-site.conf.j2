# {{ ansible_managed }} — deployment/ansible/templates/nginx-site.conf.j2
{# nginx_https — с TLS (задаётся на задаче, не set_fact); nginx_default_server —
   только у основного кооператива: default_server у двух vhost'ов — ошибка nginx. #}
{% set ds = ' default_server' if nginx_default_server | default(true) | bool else '' %}
{% macro app_locations() %}
    # Тот же предел, что MAX_CONTENT_LENGTH приложения (25 МБ), с запасом.
    client_max_body_size 30m;

    location /static/ {
        alias {{ app_dir }}/app/static/;
    }
    location /static/vendor/ {
        alias {{ app_dir }}/app/static/vendor/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Заглушка «Ведутся технические работы» (deployment/deploy/nginx-maintenance.conf):
    # флаг ставит deploy.sh; 502/504 — пока gunicorn перезапускается.
    error_page 502 503 504 @maintenance;
    location @maintenance {
        root {{ app_dir }}/deployment/deploy;
        rewrite ^ /maintenance.html break;
        add_header Retry-After 120 always;
        add_header Cache-Control "no-store" always;
    }

    location / {
        if (-f {{ app_dir }}/deployment/deploy/maintenance.on) {
            return 503;
        }
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 120s;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
{% endmacro %}

server {
    listen 80{{ ds }};
    listen [::]:80{{ ds }};
    server_name {{ coop_domain or '_' }};

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
{% if nginx_https | bool %}

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
{% if nginx_http2_directive | default(true) | bool %}
    listen 443 ssl{{ ds }};
    listen [::]:443 ssl{{ ds }};
    http2 on;
{% else %}
    listen 443 ssl http2{{ ds }};
    listen [::]:443 ssl http2{{ ds }};
{% endif %}
    server_name {{ coop_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ coop_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ coop_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000" always;
{{ app_locations() }}
}
{% else %}
{{ app_locations() }}
}
{% endif %}
